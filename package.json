{
  "name": "askaboard-plugins",
  "version": "0.1.4",
  "description": "Agent plugins that connect Claude Code, Codex, Cursor and the Claude app to Askaboard.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Nordup/askaboard-plugins"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/version.mjs --check && node scripts/validate.mjs && npm run pack",
    "validate": "node scripts/validate.mjs",
    "pack": "node claude-extensions/askaboard/scripts/pack.mjs",
    "version:sync": "node scripts/version.mjs && npm run pack",
    "check-artifact": "node scripts/check-artifact.mjs"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "^2.1.2"
  }
}
